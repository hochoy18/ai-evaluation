# 复制为 .env.local 后填入真实值（.env / .env.local 已被 git 忽略）
#   cp .env.example .env.local

# ---- 百炼 OpenAI 兼容接口（裁判模型）----
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-你的百炼API-Key

# 全局默认裁判模型：让所有 model=None 的指标都用百炼，无需逐个传 model=
OPENAI_MODEL_NAME=qwen3.7-plus
USE_OPENAI_MODEL=true

# 可选：自定义模型的 token 成本（仅用于成本统计，不影响评测分数；未知模型可不填）
# OPENAI_COST_PER_INPUT_TOKEN=0.0000008
# OPENAI_COST_PER_OUTPUT_TOKEN=0.000002

# 可选：把评测结果保存到本地目录
# DEEPEVAL_RESULTS_FOLDER=./data

# ---- RAG P0 评测门禁 ----
# 真题集路径：医疗/业务切集零门禁代码改动（架构 §10.1）
RAG_GOLDENS_FILE=./data/rag_goldens_medical.json
# 关闭 deepeval 匿名遥测
DEEPEVAL_TELEMETRY_OPT_OUT=1
# 每任务超时上限(秒):默认 180s,慢端点+推理裁判下 Faithfulness 会超时被取消(score=None)
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=600

# ---- T2 Ingestion 流水线(架构 §12.1;建索引 CLI:python -m rag_core.ingest)----
# 检索后端(门面接线随 vector 后端票;当前默认 keyword,基线可复现)
RAG_RETRIEVER=keyword
RAG_TOP_K=3
# 语料与索引位置
RAG_CORPUS_DIR=./docs
RAG_INDEX_DIR=./data/rag_index
RAG_MANIFEST_FILE=./data/rag_manifest.json
# Embedding 后端:bailian(默认,按量计费)| fake(确定性假向量,零网络零计费,仅演示/测试)
EMBEDDING_BACKEND=bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH=10               # 官方上限 10 条(v3/v4),>10 永不发出
# embedding 专用按量计费 key(双 key 双 endpoint;生成端 token-plan key 实测不可用,附录 E)
DASHSCOPE_API_KEY=sk-你的按量计费API-Key
# 成本估算(日志用)与重试
EMBEDDING_COST_PER_MILLION_TOKENS=0.5
EMBEDDING_MAX_RETRIES=5
# 切分参数(字符计量,架构 §4.3 初值,P3 校准)
RAG_CHUNK_TARGET=700
RAG_CHUNK_MAX=1100
RAG_CHUNK_MIN=140
RAG_CHUNK_OVERLAP=100
# EMBEDDING_BASE_URL=            # 缺省 dashscope compatible-mode(双 key 双 endpoint)
